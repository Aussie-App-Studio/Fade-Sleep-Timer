<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient layer - Deep purple to dark blue -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1a0a2e"
                android:centerColor="#16213e"
                android:endColor="#0f0f23"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    
    <!-- Subtle inner glow effect -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#2d1b4e"
                android:centerColor="#1a1a3e"
                android:endColor="#0d0d1f"
                android:type="linear" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    
    <!-- Top highlight for glassmorphism effect -->
    <item android:bottom="80dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#00ffffff"
                android:endColor="#08ffffff"
                android:type="linear" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
