    <!-- Support Prompts (Arrays) -->
    <string-array name="review_prompts">
        <item>Tận hưởng sự im lặng? 5 sao sẽ giúp ích.</item>
        <item>Ngủ nhanh hơn? Hãy nói với thế giới (khẽ khàng).</item>
        <item>Nếu ứng dụng hoạt động, một đánh giá sẽ giúp chúng tôi.</item>
        <item>Không muốn đánh thức bạn, nhưng hãy đánh giá chúng tôi.</item>
        <item>Vẫn chưa ngủ? Có thể viết một đánh giá.</item>
        <item>Yêu thích Fade? Đừng để các ngôi sao của chúng tôi mờ đi.</item>
        <item>Viết đánh giá rất thư giãn, bạn có biết không?</item>
        <item>Giúp chúng tôi chiến đấu với ác mộng. Cho 5 sao.</item>
        <item>Không quảng cáo, không chi phí. Một đánh giá nhỏ?</item>
        <item>Hãy là người hùng. Cứu một nhà phát triển khỏi mất ngủ.</item>
        <item>Nếu bạn đang đọc cái này, bạn nợ chúng tôi một đánh giá. Đùa thôi...?</item>
        <item>Ưu đãi cuối: Đánh giá và nhận một cái đập tay ảo.</item>
    </string-array>
    
    <string-array name="support_prompts">
        <item>Tôi có con. Chúng ăn rất nhiều. Ủng hộ nhà phát triển?</item>
        <item>Những chú khỉ lập trình của tôi muốn chuối. Tiền boa?</item>
        <item>Tôi lập trình trong bộ đồ ngủ, nhưng đó là một công việc. Một ly cà phê?</item>
        <item>Thích sự im lặng? Hãy cảm ơn những đứa con ồn ào mà tôi đang lờ đi.</item>
        <item>Đã thử trả tiền thuê nhà bằng "năng lượng tích cực", không hiệu quả.</item>
        <item>Giúp tôi chứng minh với vợ rằng đây là một công việc thực sự.</item>
        <item>9/10 bác sĩ khuyên nên ủng hộ các nhà phát triển độc lập.</item>
        <item>Đang tiết kiệm để mua quản gia robot. Mỗi xu đều có giá trị.</item>
        <item>Có tin đồn rằng sự ủng hộ cải thiện chất lượng giấc ngủ thêm 10%.</item>
        <item>Tôi hứa sẽ chi tiêu khôn ngoan (Cà phê).</item>
        <item>Lập trình tiêu tốn nhiều hơn 500% caffeine.</item>
        <item>Làm cho một nhà phát triển mỉm cười. Tốt cho nghiệp quả.</item>
    </string-array>

