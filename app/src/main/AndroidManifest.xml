<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.gollan.fadesleeptimer">


    <!-- ==================== PERMISSIONS ====================
         All permissions are justified below for Google Play compliance.
         Sensitive permissions are marked with [SENSITIVE] tag.
    ========================================================== -->

    <!-- FOREGROUND_SERVICE: Required to run the sleep timer as a foreground service.
         The timer must continue running while the app is in the background to fade audio. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    
    <!-- FOREGROUND_SERVICE_MEDIA_PLAYBACK: Required for Android 14+ to control media playback.
         The timer adjusts system volume to fade audio over time. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    
    <!-- POST_NOTIFICATIONS: Shows timer status and controls in the notification shade.
         Users can extend/stop the timer from the notification. Runtime permission on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- WAKE_LOCK: Keeps the CPU awake to ensure accurate timer countdown.
         Without this, the timer may drift or stop when the device sleeps. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- MODIFY_AUDIO_SETTINGS: Adjusts system media volume to fade audio gradually.
         Core functionality - the timer gradually reduces volume to zero over time. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    
    <!-- [SENSITIVE] SYSTEM_ALERT_WINDOW: Displays "Red Night Light" overlay.
         Feature: Red-tinted screen overlay to block blue light and help users fall asleep.
         Why needed: Overlay must appear over all apps including video players.
         User control: Optional feature, enabled only in Settings > Visuals > Red Night Light. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    
    <!-- RECEIVE_BOOT_COMPLETED: Supports "Open on Charge" feature.
         When enabled, auto-launches the app when the device is plugged in at bedtime. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- VIBRATE: Haptic feedback for "Haptic Breathing Guide" feature.
         Provides tactile cues (inhale/exhale) during breathing exercises to help relaxation. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- SCHEDULE_EXACT_ALARM: Powers "Bedtime Reminder" notifications.
         Sends reminders at the exact user-configured time (e.g., 10:00 PM). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    
    <!-- SET_ALARM: Sets wake-up alarms via "Sleep Cycle Calculator" feature.
         Calculates optimal wake time based on sleep cycles and offers to set an alarm. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    
    <!-- [SENSITIVE] REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: Ensures reliable timer operation.
         Feature: Core timer functionality.
         Why needed: Android may kill the timer service, causing audio to play indefinitely overnight.
         User control: Requested during onboarding with clear explanation. User can deny. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    
    <!-- [SENSITIVE] WRITE_SETTINGS: Powers "Gradual Screen Dim" feature.
         Feature: Gradually reduces screen brightness alongside audio fade.
         Why needed: Must modify system brightness setting to dim the screen.
         User control: Optional feature in Settings > Visuals > Gradual Screen Dim. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    
    <!-- BILLING: In-app purchases for optional premium features (Visual Pack, Hall of Fame, etc.) -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Query only media/music apps instead of all packages (Play Store compliant) -->
    <queries>
        <!-- Music and audio apps -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MUSIC_PLAYER" />
        </intent>
        <!-- Video apps (like YouTube) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <!-- All launcher apps (will show most apps) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Fade Sleep Timer"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Actions intent filter -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
            <!-- Shortcuts meta-data for App Actions -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>


        <!-- Default Icon Alias -->
        <activity-alias
